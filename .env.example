# Kopyala: cp .env.example .env   (gerçek değerleri GİTE KOYMA)
# MongoDB. Boş bırakılırsa server/data/store.json dosyası kullanılır.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bmo_news
PORT=8787
REFRESH_MINUTES=15
# Elle yenileme (POST /api/refresh) için gizli anahtar. Boşsa özellik kapalıdır.
ADMIN_TOKEN=
# Arayüz başka bir alan adından API'ye bağlanacaksa izin verilen adres (varsayılan *).
CORS_ORIGIN=
# Arayüzü başka bir sunucudaki API'ye bağlamak için (derleme zamanı): VITE_NEWS_API_BASE=https://api.ornek.com/api
